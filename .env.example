# ==============================================================================
# GhostData Deletion-Audit Agent - Environment Configuration Template
# NOTE: Do NOT commit sensitive API keys or credentials.
# ==============================================================================

# LLM Provider Configuration (e.g., openai, anthropic, gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=gemini-2.5-pro

# Pipeline Execution Settings
LOG_LEVEL=INFO
MAX_CONCURRENT_CASES=5
DATASET_DIR=./dataset
OUTPUT_FILE=./output.csv

# Auditor Policy Thresholds
STRICT_TEMPORAL_AUDIT=true
AUTO_VERIFY_EVIDENCE=true

